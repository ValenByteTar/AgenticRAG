{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://infrapolus.dev/contract/warm-v1/retrieval_metadata.schema.json",
  "title": "Warm Artifact: retrieval_metadata",
  "type": "object",
  "required": ["docs"],
  "additionalProperties": false,
  "properties": {
    "docs": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          {"$ref": "common.schema.json#/definitions/confidence_block"},
          {
            "type": "object",
            "properties": {
              "preferred_roles": {
                "type": "array",
                "items": {"type": "string"}
              },
              "two_stage_eligible": {"type": "boolean"},
              "scoping_preference": {
                "type": "string",
                "enum": ["soft_boost", "candidate_docs", "none"]
              },
              "boost_weight": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        ]
      }
    }
  }
}
