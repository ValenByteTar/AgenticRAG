{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://infrapolus.dev/contract/warm-v1/predicate_catalog.schema.json",
  "title": "Warm Artifact: predicate_catalog",
  "type": "object",
  "required": ["catalog_version", "predicates"],
  "additionalProperties": false,
  "properties": {
    "catalog_version": {"$ref": "common.schema.json#/definitions/semver"},
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z_]*$"},
          "description": {"type": "string", "minLength": 1},
          "deprecated": {"type": "boolean"}
        }
      }
    }
  }
}
