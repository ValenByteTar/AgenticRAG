{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://infrapolus.dev/contract/warm-v1/manifest.schema.json",
  "title": "Warm Contract v1 - build manifest",
  "type": "object",
  "required": ["build_id", "contract_version", "builder_version", "created_at", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "build_id": {"type": "string", "minLength": 1},
    "contract_version": {"const": "warm-v1"},
    "builder_version": {"$ref": "common.schema.json#/definitions/semver"},
    "created_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "path"],
        "additionalProperties": false,
        "properties": {
          "sha256": {"$ref": "common.schema.json#/definitions/sha256"},
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
