{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://infrapolus.dev/contract/warm-v1/entity_relations.schema.json",
  "title": "Warm Artifact: entity_relations",
  "type": "object",
  "required": ["relations"],
  "additionalProperties": false,
  "properties": {
    "relations": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "common.schema.json#/definitions/confidence_block"},
          {
            "type": "object",
            "required": ["relation_id", "subject", "predicate", "object", "evidence"],
            "additionalProperties": true,
            "properties": {
              "relation_id": {"type": "string", "pattern": "^rel:[a-z0-9][a-z0-9\\-]*$"},
              "subject": {"$ref": "common.schema.json#/definitions/entity_id"},
              "predicate": {"type": "string", "minLength": 1},
              "object": {"$ref": "common.schema.json#/definitions/entity_id"},
              "evidence": {"$ref": "common.schema.json#/definitions/evidence"},
              "attributes": {
                "type": "array",
                "items": {"type": "string"},
                "description": "Edge attributes (ADR-0021 §4): certifies, supersedes, location, comparison, etc."
              }
            }
          }
        ]
      }
    }
  }
}
