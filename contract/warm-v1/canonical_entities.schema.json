{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://infrapolus.dev/contract/warm-v1/canonical_entities.schema.json",
  "title": "Warm Artifact: canonical_entities",
  "type": "object",
  "required": ["entities"],
  "additionalProperties": false,
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "common.schema.json#/definitions/confidence_block"},
          {
            "type": "object",
            "required": ["entity_id", "canonical_name", "types"],
            "properties": {
              "entity_id": {"$ref": "common.schema.json#/definitions/entity_id"},
              "canonical_name": {"type": "string", "minLength": 1},
              "types": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  }
}
